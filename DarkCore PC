export default function App() {
  // Navigation Routing States
  const [activeTab, setActiveTab] = useState('home'); // home, builder, wizard, catalog, compare, user
  const [selectedCategoryFilter, setSelectedCategoryFilter] = useState('Todos');
  const [searchQuery, setSearchQuery] = useState('');
  const [searchFocused, setSearchFocused] = useState(false);

  // Cart & Favorites System State
  const [cart, setCart] = useState([]);
  const [isCartOpen, setIsCartOpen] = useState(false);
  const [favorites, setFavorites] = useState([]);
  const [toastMessage, setToastMessage] = useState(null);

  // Product Details Modal State
  const [selectedProduct, setSelectedProduct] = useState(null);

  // Compare Tool State
  const [compareList, setCompareList] = useState([]);

  // Custom PC Builder State
  const [builderParts, setBuilderParts] = useState({
    cpu: null,
    cooler: null,
    motherboard: null,
    ram: null,
    gpu: null,
    ssd: null,
    psu: null,
    case: null
  });

  // Wizard Questions State
  const [wizardStep, setWizardStep] = useState(0);
  const [wizardAnswers, setWizardAnswers] = useState({
    budget: 4000,
    resolution: '1080p',
    games: [],
    needPeripherals: false
  });
  const [recommendedPcResult, setRecommendedPcResult] = useState(null);

  // Checkout Flow Modal State
  const [isCheckoutOpen, setIsCheckoutOpen] = useState(false);
  const [checkoutStep, setCheckoutStep] = useState(1);
  const [couponCode, setCouponCode] = useState('');
  const [appliedDiscount, setAppliedDiscount] = useState(0);
  const [paymentMethod, setPaymentMethod] = useState('pix');

  // CEP Shipping Simulator State
  const [cepInput, setCepInput] = useState('');
  const [calculatedFreight, setCalculatedFreight] = useState(null);

  const showNotification = (msg) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(null), 3000);
  };

  const addToCart = (product, qty = 1) => {
    setCart(prev => {
      const existing = prev.find(item => item.id === product.id);
      if (existing) {
        return prev.map(item => item.id === product.id ? { ...item, quantity: item.quantity + qty } : item);
      }
      return [...prev, { ...product, quantity: qty }];
    });
    showNotification(`"${product.name.slice(0, 25)}..." adicionado ao carrinho!`);
  };

  const removeFromCart = (id) => {
    setCart(prev => prev.filter(item => item.id !== id));
  };

  const updateCartQty = (id, delta) => {
    setCart(prev => prev.map(item => {
      if (item.id === id) {
        const newQty = item.quantity + delta;
        return newQty > 0 ? { ...item, quantity: newQty } : item;
      }
      return item;
    }));
  };

  const toggleFavorite = (productId) => {
    setFavorites(prev => {
      const isFav = prev.includes(productId);
      if (isFav) {
        showNotification("Removido dos favoritos.");
        return prev.filter(id => id !== productId);
      } else {
        showNotification("Adicionado aos favoritos!");
        return [...prev, productId];
      }
    });
  };

  const toggleCompare = (product) => {
    setCompareList(prev => {
      const exists = prev.some(p => p.id === product.id);
      if (exists) {
        return prev.filter(p => p.id !== product.id);
      } else {
        if (prev.length >= 4) {
          showNotification("Apenas até 4 produtos podem ser comparados por vez.");
          return prev;
        }
        showNotification("Produto adicionado ao Comparador!");
        return [...prev, product];
      }
    });
  };

  const cartSubtotal = useMemo(() => {
    return cart.reduce((acc, item) => acc + (item.priceCard * item.quantity), 0);
  }, [cart]);

  const cartPixSubtotal = useMemo(() => {
    return cart.reduce((acc, item) => acc + (item.pricePix * item.quantity), 0);
  }, [cart]);

  const applyCoupon = () => {
    if (couponCode.toUpperCase() === 'DARKCORE10') {
      setAppliedDiscount(0.10);
      showNotification('Cupom DARKCORE10 aplicado! 10% de desconto adicional.');
    } else {
      showNotification('Cupom inválido. Tente "DARKCORE10"');
    }
  };

  const builderStats = useMemo(() => {
    let totalCard = 0;
    let totalPix = 0;
    let estimatedTdp = 120; // Base system wattage
    let issues = [];
    let warnings = [];

    const { cpu, motherboard, ram, gpu, psu } = builderParts;

    Object.values(builderParts).forEach(part => {
      if (part) {
        totalCard += part.priceCard;
        totalPix += part.pricePix;
        if (part.specs?.powerTdp) {
          estimatedTdp += part.specs.powerTdp;
        }
      }
    });

    // CPU vs Motherboard Socket Compatibility Check
    if (cpu && motherboard) {
      if (cpu.specs?.socket !== motherboard.specs?.socket) {
        issues.push(`Incompatibilidade de Soquete: CPU (${cpu.specs?.socket}) não encaixa na Placa-Mãe (${motherboard.specs?.socket}).`);
      }
    }

    // RAM vs Motherboard Type Check
    if (ram && motherboard) {
      const isDdr5Ram = ram.specs?.type === 'DDR5';
      const isDdr5Mb = motherboard.specs?.ramSlots?.includes('DDR5');
      if (isDdr5Ram && !isDdr5Mb) {
        issues.push(`Incompatibilidade de RAM: A memória é DDR5 mas a Placa-Mãe suporta apenas DDR4.`);
      } else if (!isDdr5Ram && isDdr5Mb) {
        issues.push(`Incompatibilidade de RAM: A memória é DDR4 mas a Placa-Mãe exige DDR5.`);
      }
    }

