        {/* VIEW 5: COMPARADOR DE PRODUTOS */}
        {activeTab === 'compare' && (
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
            <div className="flex justify-between items-center border-b border-gray-800 pb-4">
              <h1 className="text-2xl font-black font-mono text-white flex items-center space-x-2">
                <ArrowLeftRight className="w-6 h-6 text-cyan-400" />
                <span>COMPARADOR DE PRODUTOS ({compareList.length}/4)</span>
              </h1>
              {compareList.length > 0 && (
                <button onClick={() => setCompareList([])} className="text-xs text-red-400 hover:underline">
                  Limpar Comparação
                </button>
              )}
            </div>

            {compareList.length === 0 ? (
              <div className="text-center py-16 space-y-4">
                <p className="text-gray-400">Nenhum produto selecionado para comparação.</p>
                <button onClick={() => setActiveTab('catalog')} className="bg-cyan-500 text-black font-bold text-xs px-6 py-2.5 rounded-xl">
                  Ir para o Catálogo
                </button>
              </div>
            ) : (
              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse">
                  <thead>
                    <tr>
                      <th className="p-4 bg-[#12141c] border border-gray-800 text-xs font-bold text-gray-400 w-1/5">Especificação</th>
                      {compareList.map(prod => (
                        <th key={prod.id} className="p-4 bg-[#12141c] border border-gray-800 min-w-[220px]">
                          <div className="space-y-2">
                            <img src={prod.image} alt={prod.name} className="w-24 h-24 object-cover rounded mx-auto" />
                            <h4 className="text-xs font-bold text-white line-clamp-2 text-center">{prod.name}</h4>
                            <div className="text-center font-mono text-cyan-400 font-bold text-sm">
                              R$ {prod.pricePix.toFixed(2)} PIX
                            </div>
                            <button
                              onClick={() => setCompareList(prev => prev.filter(p => p.id !== prod.id))}
                              className="w-full text-[10px] text-red-400 hover:underline"
                            >
                              Remover
                            </button>
                          </div>
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody className="text-xs text-gray-300">
                    <tr>
                      <td className="p-4 bg-[#1a1d29] border border-gray-800 font-bold">Marca</td>
                      {compareList.map(prod => (
                        <td key={prod.id} className="p-4 bg-[#12141c] border border-gray-800">{prod.brand}</td>
                      ))}
                    </tr>
                    <tr>
                      <td className="p-4 bg-[#1a1d29] border border-gray-800 font-bold">Garantia</td>
                      {compareList.map(prod => (
                        <td key={prod.id} className="p-4 bg-[#12141c] border border-gray-800">{prod.specs?.warranty || '1 Ano'}</td>
                      ))}
                    </tr>
                    <tr>
                      <td className="p-4 bg-[#1a1d29] border border-gray-800 font-bold">Consumo TDP</td>
                      {compareList.map(prod => (
                        <td key={prod.id} className="p-4 bg-[#12141c] border border-gray-800">{prod.specs?.powerTdp ? `${prod.specs.powerTdp}W` : 'N/A'}</td>
                      ))}
                    </tr>
                  </tbody>
                </table>
              </div>
            )}
          </div>
        )}

        {/* VIEW 6: ÁREA DO CLIENTE */}
        {activeTab === 'user' && (
          <div className="max-w-4xl mx-auto px-4 py-8 space-y-6">
            <div className="bg-[#12141c] border border-gray-800 rounded-2xl p-6 flex items-center space-x-4">
              <div className="w-16 h-16 rounded-full bg-purple-600 flex items-center justify-center text-white text-2xl font-bold">
                DC
              </div>
              <div>
                <h2 className="text-xl font-bold font-mono text-white">Gamer DarkCore</h2>
                <p className="text-xs text-gray-400">cliente@darkcore.com.br</p>
              </div>
            </div>

            <div className="bg-[#12141c] border border-gray-800 rounded-2xl p-6 space-y-4">
              <h3 className="text-lg font-bold font-mono text-white">MEUS PEDIDOS RECENTES</h3>
              <div className="bg-[#1a1d29] p-4 rounded-xl border border-gray-800 flex justify-between items-center text-xs">
                <div>
                  <span className="font-bold text-cyan-400 block">Pedido #DC-98421</span>
                  <span className="text-gray-400">1x RTX 4060 Dual Fan 8GB</span>
                </div>
                <span className="bg-yellow-950 text-yellow-400 px-3 py-1 rounded-full font-bold">Em Separação</span>
              </div>
            </div>
          </div>
        )}
      </main>

      {}
      {selectedProduct && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#12141c] border border-gray-800 rounded-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto p-6 space-y-6 relative">
            <button
              onClick={() => setSelectedProduct(null)}
              className="absolute top-4 right-4 p-2 text-gray-400 hover:text-white bg-gray-800 rounded-lg"
            >
              <X className="w-5 h-5" />
            </button>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <img src={selectedProduct.image} alt={selectedProduct.name} className="w-full h-64 object-cover rounded-xl" />
              <div className="space-y-4">
                <span className="text-xs font-bold text-purple-400 uppercase">{selectedProduct.category}</span>
                <h2 className="text-xl font-bold text-white font-mono">{selectedProduct.name}</h2>
                <div className="text-3xl font-black text-cyan-400 font-mono">
                  R$ {selectedProduct.pricePix.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
                  <span className="text-xs text-gray-400 block font-normal">no PIX ou 12x de R$ {(selectedProduct.priceCard / 12).toFixed(2)}</span>
                </div>

                {/* Freight Simulator */}
                <div className="bg-[#1a1d29] p-3 rounded-xl space-y-2 border border-gray-800">
                  <span className="text-xs text-gray-400 font-semibold">Calcular Frete e Prazo:</span>
                  <div className="flex space-x-2">
                    <input
                      type="text"
                      placeholder="00000-000"
                      value={cepInput}
                      onChange={(e) => setCepInput(e.target.value)}
                      className="bg-black/50 border border-gray-700 text-xs px-3 py-1.5 rounded text-white w-full outline-none"
                    />
                    <button
                      onClick={() => setCalculatedFreight({ price: 'GRÁTIS', days: '2 dias úteis' })}
                      className="bg-gray-800 text-xs px-3 py-1.5 rounded text-gray-200 hover:bg-gray-700"
                    >
                      OK
                    </button>
                  </div>
                  {calculatedFreight && (
                    <p className="text-[11px] text-green-400 font-bold">Sedex Express: {calculatedFreight.price} ({calculatedFreight.days})</p>
                  )}
                </div>

                <button
                  onClick={() => {
                    addToCart(selectedProduct);
                    setSelectedProduct(null);
                  }}
                  className="w-full bg-cyan-500 hover:bg-cyan-400 text-black font-extrabold py-3 rounded-xl transition text-xs uppercase shadow-lg shadow-cyan-500/20"
                >
                  Adicionar ao Carrinho
                </button>
              </div>
            </div>

            {/* Tech Specs */}
            <div className="border-t border-gray-800 pt-4 space-y-2">
              <h3 className="text-sm font-bold text-white font-mono uppercase">Especificações Técnicas</h3>
              <p className="text-xs text-gray-300 leading-relaxed">{selectedProduct.description}</p>
            </div>
          </div>
        </div>
      )}

      {}
      {isCartOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex justify-end">
          <div className="bg-[#12141c] w-full max-w-md h-full flex flex-col justify-between border-l border-gray-800 p-6 space-y-4">
            <div className="flex justify-between items-center border-b border-gray-800 pb-4">
              <h2 className="text-lg font-bold font-mono text-white flex items-center space-x-2">
                <ShoppingCart className="w-5 h-5 text-cyan-400" />
                <span>SEU CARRINHO ({cart.length})</span>
              </h2>
              <button onClick={() => setIsCartOpen(false)} className="text-gray-400 hover:text-white">
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="flex-1 overflow-y-auto space-y-4 pr-1">
              {cart.map(item => (
                <div key={item.id} className="bg-[#1a1d29] p-3 rounded-xl border border-gray-800 flex space-x-3 items-center">
                  <img src={item.image} alt={item.name} className="w-16 h-16 object-cover rounded-lg" />
                  <div className="flex-1 min-w-0">
                    <h4 className="text-xs font-bold text-white truncate">{item.name}</h4>
                    <span className="text-xs text-cyan-400 font-mono font-bold block">
                      R$ {item.pricePix.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}
                    </span>
                    <div className="flex items-center space-x-2 mt-2">
                      <button onClick={() => updateCartQty(item.id, -1)} className="p-1 bg-gray-800 rounded"><Minus className="w-3 h-3 text-white" /></button>
                      <span className="text-xs font-bold text-white">{item.quantity}</span>
                      <button onClick={() => updateCartQty(item.id, 1)} className="p-1 bg-gray-800 rounded"><Plus className="w-3 h-3 text-white" /></button>
                    </div>
                  </div>
                  <button onClick={() => removeFromCart(item.id)} className="text-red-400 hover:text-red-300">
                    <Trash2 className="w-4 h-4" />
                  </button>
                </div>
              ))}
              {cart.length === 0 && (
                <div className="text-center py-12 text-gray-500 text-sm">Seu carrinho está vazio.</div>
              )}
            </div>

            {cart.length > 0 && (
              <div className="border-t border-gray-800 pt-4 space-y-3">
                {/* Coupon Code Input */}
                <div className="flex space-x-2">
                  <input
                    type="text"
                    placeholder="Cupom de desconto"
                    value={couponCode}
                    onChange={(e) => setCouponCode(e.target.value)}
                    className="bg-[#1a1d29] border border-gray-700 text-xs px-3 py-2 rounded text-white flex-1 uppercase"
                  />
                  <button onClick={applyCoupon} className="bg-purple-600 text-xs font-bold px-3 py-2 rounded text-white">Aplicar</button>
                </div>

                <div className="space-y-1 text-xs">
                  <div className="flex justify-between text-gray-400">
                    <span>Subtotal:</span>
                    <span>R$ {cartPixSubtotal.toFixed(2)}</span>
                  </div>
                  {appliedDiscount > 0 && (
                    <div className="flex justify-between text-green-400">
                      <span>Desconto Cupom (10%):</span>
                      <span>- R$ {(cartPixSubtotal * appliedDiscount).toFixed(2)}</span>
                    </div>
                  )}
                  <div className="flex justify-between text-base font-bold text-cyan-400 font-mono pt-2 border-t border-gray-800">
                    <span>Total PIX:</span>
                    <span>R$ {(cartPixSubtotal * (1 - appliedDiscount)).toFixed(2)}</span>
                  </div>
                </div>

                <button
                  onClick={() => {
                    setIsCartOpen(false);
                    setIsCheckoutOpen(true);
                  }}
                  className="w-full bg-cyan-500 hover:bg-cyan-400 text-black font-extrabold py-3 rounded-xl transition text-xs uppercase"
                >
                  Finalizar Compra
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      {}
      {isCheckoutOpen && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#12141c] border border-gray-800 rounded-2xl max-w-2xl w-full p-6 space-y-6 relative">
            <button onClick={() => setIsCheckoutOpen(false)} className="absolute top-4 right-4 text-gray-400 hover:text-white">
              <X className="w-5 h-5" />
            </button>

            <h2 className="text-xl font-bold font-mono text-white flex items-center space-x-2">
              <Lock className="w-5 h-5 text-cyan-400" />
              <span>CHECKOUT SEGURO DARKCORE</span>
            </h2>

            {/* Steps indicator */}
            <div className="flex justify-between border-b border-gray-800 pb-3 text-xs font-bold">
              <span className={checkoutStep >= 1 ? 'text-cyan-400' : 'text-gray-500'}>1. Endereço</span>
              <span className={checkoutStep >= 2 ? 'text-cyan-400' : 'text-gray-500'}>2. Pagamento</span>
              <span className={checkoutStep === 3 ? 'text-cyan-400' : 'text-gray-500'}>3. Confirmação</span>
            </div>

            {checkoutStep === 1 && (
              <div className="space-y-4 text-xs">
                <input type="text" placeholder="Nome Completo" className="w-full bg-[#1a1d29] border border-gray-700 p-3 rounded text-white" defaultValue="Cliente Gamer" />
                <input type="text" placeholder="CPF" className="w-full bg-[#1a1d29] border border-gray-700 p-3 rounded text-white" defaultValue="000.000.000-00" />
                <input type="text" placeholder="CEP / Endereço de Entrega" className="w-full bg-[#1a1d29] border border-gray-700 p-3 rounded text-white" defaultValue="Av. Paulista, 1000 - São Paulo, SP" />
                <button onClick={() => setCheckoutStep(2)} className="w-full bg-cyan-500 text-black font-bold p-3 rounded-xl">Ir para Pagamento</button>
              </div>
            )}

            {checkoutStep === 2 && (
              <div className="space-y-4 text-xs">
                <div className="grid grid-cols-3 gap-3">
                  {['pix', 'card', 'boleto'].map(method => (
                    <button
                      key={method}
                      onClick={() => setPaymentMethod(method)}
                      className={`p-3 rounded-xl border uppercase font-bold text-center ${paymentMethod === method ? 'bg-purple-950 border-purple-500 text-white' : 'bg-[#1a1d29] border-gray-800 text-gray-400'}`}
                    >
                      {method}
                    </button>
                  ))}
                </div>

                {paymentMethod === 'pix' && (
                  <div className="bg-[#1a1d29] p-4 rounded-xl text-center space-y-2 border border-gray-800">
                    <QrCode className="w-24 h-24 mx-auto text-cyan-400" />
                    <p className="text-gray-300 font-mono">Chave PIX gerada com sucesso!</p>
                  </div>
                )}

                <button onClick={() => setCheckoutStep(3)} className="w-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-bold p-3 rounded-xl">
                  Confirmar e Finalizar Pedido
                </button>
              </div>
            )}

            {checkoutStep === 3 && (
              <div className="text-center space-y-4 py-4">
                <CheckCircle2 className="w-16 h-16 text-green-400 mx-auto" />
                <h3 className="text-xl font-bold font-mono text-white">PEDIDO REALIZADO COM SUCESSO!</h3>
                <p className="text-xs text-gray-400">Código de rastreio: <strong className="text-cyan-400">DC-84920482BR</strong></p>
                <button onClick={() => { setIsCheckoutOpen(false); setCart([]); setCheckoutStep(1); }} className="bg-cyan-500 text-black font-bold px-6 py-2.5 rounded-xl text-xs">
                  Voltar para a Loja
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      {}
      <footer className="bg-[#08090c] border-t border-gray-800 text-xs text-gray-400 py-12 mt-auto">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
          <div className="space-y-3">
            <span className="text-xl font-black text-white font-mono">DARK<span className="text-cyan-400">CORE</span></span>
            <p className="text-gray-500">A maior loja brasileira especializada em hardware de alta performance e PCs gamer customizados.</p>
          </div>
          <div>
            <h4 className="font-bold text-white font-mono uppercase mb-3">Atendimento</h4>
            <ul className="space-y-2">
              <li>Central de Ajuda</li>
              <li>Garantia e Trocas</li>
              <li>Fale Conosco</li>
            </ul>
          </div>
          <div>
            <h4 className="font-bold text-white font-mono uppercase mb-3">Institucional</h4>
            <ul className="space-y-2">
              <li>Sobre a DarkCore</li>
              <li>Políticas de Privacidade</li>
              <li>Termos e Condições</li>
            </ul>
          </div>
          <div>
            <h4 className="font-bold text-white font-mono uppercase mb-3">Pagamento Seguro</h4>
            <div className="flex space-x-2 text-gray-300">
              <QrCode className="w-6 h-6" />
              <CreditCard className="w-6 h-6" />
              <FileText className="w-6 h-6" />
            </div>
          </div>
        </div>
      </footer>
    </div>
  );
}
